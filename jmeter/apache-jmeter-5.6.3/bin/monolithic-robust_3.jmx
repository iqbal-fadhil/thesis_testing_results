<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Django Login Test Plan" enabled="true">
      <stringProp name="TestPlan.comments"/>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE" elementType="Argument">
            <stringProp name="Argument.name">BASE</stringProp>
            <stringProp name="Argument.value">https://structure.englishqualification.my.id</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LOGIN_PATH" elementType="Argument">
            <stringProp name="Argument.name">LOGIN_PATH</stringProp>
            <stringProp name="Argument.value">/accounts/login/</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PROFILE_PATH" elementType="Argument">
            <stringProp name="Argument.name">PROFILE_PATH</stringProp>
            <stringProp name="Argument.value">/accounts/profile/</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TEST_PATH" elementType="Argument">
            <stringProp name="Argument.name">TEST_PATH</stringProp>
            <stringProp name="Argument.value">/accounts/test/</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LOGOUT_PATH" elementType="Argument">
            <stringProp name="Argument.name">LOGOUT_PATH</stringProp>
            <stringProp name="Argument.value">/accounts/logout/</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="USERNAME" elementType="Argument">
            <stringProp name="Argument.name">USERNAME</stringProp>
            <stringProp name="Argument.value">student1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">PASSWORD</stringProp>
            <stringProp name="Argument.value">Student123!</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"/>
    </TestPlan>
    <hashTree>
      <!-- Thread Group -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Users" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <longProp name="ThreadGroup.start_time">1620000000000</longProp>
        <longProp name="ThreadGroup.end_time">1620000000000</longProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"/>
        <stringProp name="ThreadGroup.delay"/>
      </ThreadGroup>
      <hashTree>
        <!-- HTTP Request Defaults -->
        <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__BeanShell(new org.apache.jmeter.protocol.http.control.gui.HttpDefaultsGui(); vars.get('BASE').replace('https://','').replace('http://',''))}</stringProp>
          <stringProp name="HTTPSampler.port"/>
          <stringProp name="HTTPSampler.protocol">https</stringProp>
          <stringProp name="HTTPSampler.contentEncoding"/>
          <stringProp name="HTTPSampler.path"/>
        </ConfigTestElement>
        <hashTree/>
        <!-- Cookie Manager -->
        <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="HTTP Cookie Manager" enabled="true">
          <collectionProp name="CookieManager.cookies"/>
          <boolProp name="CookieManager.clearEachIteration">false</boolProp>
          <stringProp name="CookieManager.policy">standard</stringProp>
        </CookieManager>
        <hashTree/>
        <!-- Header Manager (will set Referer during POST by override) -->
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
          <collectionProp name="HeaderManager.headers"/>
        </HeaderManager>
        <hashTree/>
        <!-- GET Login Page -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET Login Page" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__BeanShell(vars.get('BASE').replace('https://','').replace('http://',''))}</stringProp>
          <stringProp name="HTTPSampler.port"></stringProp>
          <stringProp name="HTTPSampler.protocol">${__BeanShell(vars.get('BASE').startsWith('https')? 'https':'http')}</stringProp>
          <stringProp name="HTTPSampler.path">${LOGIN_PATH}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <!-- Extract CSRF token from hidden input -->
          <CSS/JQueryExtractor guiclass="CssExtractorGui" testclass="CSS/JQueryExtractor" testname="Extract CSRF from login form" enabled="true">
            <stringProp name="CSSSelector">input[name=csrfmiddlewaretoken]</stringProp>
            <stringProp name="Attribute">value</stringProp>
            <stringProp name="MatchNumber">1</stringProp>
            <stringProp name="DefaultValue">NOT_FOUND</stringProp>
            <stringProp name="RefName">csrf_token</stringProp>
          </CSS/JQueryExtractor>
          <hashTree/>
          <!-- Response Assertion to ensure 200 -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Login page status 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="1">HTTP/1.1 200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <boolProp name="ResponseAssertion.assume_success">false</boolProp>
            <intProp name="ResponseAssertion.test_field">0</intProp>
            <boolProp name="ResponseAssertion.test_type">2</boolProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>

        <!-- POST Login -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST Login" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="username" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">username</stringProp>
                <stringProp name="Argument.value">${USERNAME}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="password" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">password</stringProp>
                <stringProp name="Argument.value">${PASSWORD}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="csrfmiddlewaretoken" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">csrfmiddlewaretoken</stringProp>
                <stringProp name="Argument.value">${csrf_token}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.protocol">${__BeanShell(vars.get('BASE').startsWith('https')? 'https':'http')}</stringProp>
          <stringProp name="HTTPSampler.domain">${__BeanShell(vars.get('BASE').replace('https://','').replace('http://',''))}</stringProp>
          <stringProp name="HTTPSampler.path">${LOGIN_PATH}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <!-- Add Referer header for login -->
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Login Headers" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="Referer" elementType="Header">
                <stringProp name="Header.name">Referer</stringProp>
                <stringProp name="Header.value">${BASE}${LOGIN_PATH}</stringProp>
              </elementProp>
              <elementProp name="Content-Type" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/x-www-form-urlencoded</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Login response status check" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="1">302</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <boolProp name="ResponseAssertion.assume_success">false</boolProp>
            <intProp name="ResponseAssertion.test_field">0</intProp>
            <boolProp name="ResponseAssertion.test_type">2</boolProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>

        <!-- GET Profile Page -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET Profile Page" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.protocol">${__BeanShell(vars.get('BASE').startsWith('https')? 'https':'http')}</stringProp>
          <stringProp name="HTTPSampler.domain">${__BeanShell(vars.get('BASE').replace('https://','').replace('http://',''))}</stringProp>
          <stringProp name="HTTPSampler.path">${PROFILE_PATH}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Profile contains username" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="1">${USERNAME}</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <boolProp name="ResponseAssertion.assume_success">false</boolProp>
            <intProp name="ResponseAssertion.test_field">2</intProp>
            <boolProp name="ResponseAssertion.test_type">2</boolProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>

        <!-- GET Test Page with random id 1..10 -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET Test Page" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.protocol">${__BeanShell(vars.get('BASE').startsWith('https')? 'https':'http')}</stringProp>
          <stringProp name="HTTPSampler.domain">${__BeanShell(vars.get('BASE').replace('https://','').replace('http://',''))}</stringProp>
          <stringProp name="HTTPSampler.path">${TEST_PATH}${__Random(1,10,questionId)}/</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Test page 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="1">HTTP/1.1 200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <boolProp name="ResponseAssertion.assume_success">false</boolProp>
            <intProp name="ResponseAssertion.test_field">0</intProp>
            <boolProp name="ResponseAssertion.test_type">2</boolProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>

        <!-- Logout GET -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET Logout" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.protocol">${__BeanShell(vars.get('BASE').startsWith('https')? 'https':'http')}</stringProp>
          <stringProp name="HTTPSampler.domain">${__BeanShell(vars.get('BASE').replace('https://','').replace('http://',''))}</stringProp>
          <stringProp name="HTTPSampler.path">${LOGOUT_PATH}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree/>
        <!-- Think time (1s) -->
        <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Think Time 1s" enabled="true">
          <stringProp name="ConstantTimer.delay">1000</stringProp>
        </ConstantTimer>
        <hashTree/>
        <!-- View Results Tree (for GUI debugging) -->
        <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="View Results Tree" enabled="true">
          <boolProp name="saveConfig">false</boolProp>
          <objProp>
            <name>saveSamplerData</name>
            <value class="SampleSaveConfiguration">
              <boolProp name="saveResponseData">true</boolProp>
              <boolProp name="saveResponseHeaders">true</boolProp>
              <boolProp name="saveRequestHeaders">true</boolProp>
            </value>
          </objProp>
        </ResultCollector>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
