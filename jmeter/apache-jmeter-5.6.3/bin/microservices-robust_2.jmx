          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract Token (robust)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
import groovy.json.JsonSlurper

String resp = prev.getResponseDataAsString()
String respTrim = resp == null ? &quot;&quot; : resp.trim()
String rc = prev.getResponseCode()

vars.put(&quot;login_response_raw&quot;, respTrim)
vars.put(&quot;login_response_code&quot;, rc)

String tokenValue = &quot;&quot;

if (respTrim) {
    try {
        def json = new JsonSlurper().parseText(respTrim)
        if (json instanceof Map) {
            tokenValue = (json.token ?: json.access_token ?: (json.data?.token ?: json.data?.access_token)) ?: &quot;&quot;
        } else {
            tokenValue = &quot;&quot;
        }
    } catch (Exception e) {
        def m = (respTrim =~ /(?i)(?:\&quot;token\&quot;|\&quot;access_token\&quot;|access_token)\s*[:=]\s*[&quot;&apos;]?([A-Za-z0-9\-\._]+)[&quot;&apos;]?/)
        if (m.find()) {
            tokenValue = m.group(1)
        } else {
            log.warn(&quot;Extract Token: response not JSON and regex failed. responseCode=${rc}&quot;)
            log.debug(&quot;Extract Token raw response (first 2000 chars):\n&quot; + (respTrim.length() &gt; 2000 ? respTrim[0..1999] : respTrim))
        }
    }
} else {
    log.warn(&quot;Extract Token: empty response. responseCode=${rc}&quot;)
}

vars.put(&quot;token&quot;, tokenValue ?: &quot;&quot;)
vars.put(&quot;login_has_token&quot;, tokenValue ? &quot;true&quot; : &quot;false&quot;)
            </stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
