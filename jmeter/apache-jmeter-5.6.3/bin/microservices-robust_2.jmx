        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Gen Random Answers (1..10)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
import groovy.json.JsonOutput
def rnd = new Random()
def choices = [&quot;A&quot;,&quot;B&quot;,&quot;C&quot;,&quot;D&quot;]
def answers = []
(1..10).each { qid -&gt;
    answers &lt;&lt; [ question_id: qid, selected_option: choices[rnd.nextInt(choices.size())] ]
}
def body = [ answers: answers ]
vars.put(&quot;submit_body&quot;, JsonOutput.toJson(body))
            </stringProp>
